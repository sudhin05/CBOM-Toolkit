<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CBOM Report – {{ project }}</title>
<style>
  :root {
    --bg: #f7f7f5; --card: #ffffff; --text: #1d1d1b; --muted: #6b6b66; --line: #e3e2dc;
    --red: #c8352b; --red-bg: #fbe9e7; --yellow: #a86b00; --yellow-bg: #fdf3dc;
    --green: #2e7d32; --green-bg: #e6f2e6; --info: #55606e; --info-bg: #eceef1;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161615; --card: #1f1f1d; --text: #ecebe6; --muted: #a09f98; --line: #34332f;
      --red: #ff8a80; --red-bg: #3a1e1c; --yellow: #ffcc66; --yellow-bg: #362c16;
      --green: #8fd694; --green-bg: #1d3220; --info: #b4bcc8; --info-bg: #2a2d31;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1180px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 26px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 36px 0 12px; }
  .muted { color: var(--muted); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 20px; }
  .top { display: grid; grid-template-columns: 220px 1fr; gap: 16px; margin-top: 24px; }
  .score { text-align: center; }
  .score .num { font-size: 48px; font-weight: 700; line-height: 1.1; }
  .bar { display: flex; height: 22px; border-radius: 6px; overflow: hidden; margin: 10px 0 14px; background: var(--line); }
  .bar div { height: 100%; }
  .legend { display: flex; flex-wrap: wrap; gap: 18px; }
  .legend b { font-size: 22px; display: block; }
  .chip { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap; }
  .red { color: var(--red); background: var(--red-bg); }
  .yellow { color: var(--yellow); background: var(--yellow-bg); }
  .green { color: var(--green); background: var(--green-bg); }
  .info { color: var(--info); background: var(--info-bg); }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; align-items: center; }
  .filters button { border: 1px solid var(--line); background: var(--card); color: var(--text);
                    border-radius: 6px; padding: 5px 11px; cursor: pointer; font: inherit; font-size: 13px; }
  .filters button.on { border-color: var(--text); font-weight: 600; }
  .filters input { flex: 1; min-width: 160px; padding: 6px 10px; border: 1px solid var(--line);
                   border-radius: 6px; background: var(--card); color: var(--text); font: inherit; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  code { font-family: ui-monospace, Consolas, monospace; font-size: 12.5px; word-break: break-all; }
  .small { font-size: 12.5px; }
  @media (max-width: 720px) { .top { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<main>
  <h1>Cryptographic Bill of Materials</h1>
  <div class="muted">{{ project }} · scanned {{ timestamp }} · cbom-scanner {{ version }}</div>

  <div class="top">
    <div class="card score">
      <div class="muted small">Quantum readiness</div>
      <div class="num">{{ summary.readiness_score if summary.readiness_score is not none else "–" }}{% if summary.readiness_score is not none %}%{% endif %}</div>
      <div class="muted small">{{ summary.counts.green }} of {{ summary.total_assets }} assets quantum-safe</div>
    </div>
    <div class="card">
      <div><b>{{ summary.counts.red }} of {{ summary.total_assets }}</b> crypto assets will be broken by quantum computers</div>
      {% set t = summary.total_assets if summary.total_assets else 1 %}
      <div class="bar" role="img" aria-label="red {{ summary.counts.red }}, yellow {{ summary.counts.yellow }}, green {{ summary.counts.green }}">
        <div style="width: {{ 100 * summary.counts.red / t }}%; background: var(--red)"></div>
        <div style="width: {{ 100 * summary.counts.yellow / t }}%; background: var(--yellow)"></div>
        <div style="width: {{ 100 * summary.counts.green / t }}%; background: var(--green)"></div>
      </div>
      <div class="legend">
        <div><b style="color: var(--red)">{{ summary.counts.red }}</b><span class="chip red">red</span> broken by quantum</div>
        <div><b style="color: var(--yellow)">{{ summary.counts.yellow }}</b><span class="chip yellow">yellow</span> weak today / weakened</div>
        <div><b style="color: var(--green)">{{ summary.counts.green }}</b><span class="chip green">green</span> quantum-safe</div>
        <div><b style="color: var(--info)">{{ summary.counts.info }}</b><span class="chip info">info</span> crypto libraries</div>
      </div>
      <div class="muted small" style="margin-top: 12px">
        By source:
        {% for src, n in by_source.items() %}{{ src }} {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}
      </div>
    </div>
  </div>

  {% if tls %}
  <h2>Websites</h2>
  <div class="card table-wrap">
    <table>
      <tr><th>Target</th><th>Default version</th><th>Accepted versions</th><th>Cipher suite</th><th>Key exchange group</th></tr>
      {% for s in tls %}
      <tr>
        <td><code>{{ s.target }}</code></td>
        {% if s.error %}<td colspan="4" class="muted">{{ s.error }}</td>{% else %}
        <td>{{ s.default_version }}</td>
        <td>{{ s.versions | join(", ") }}</td>
        <td><code>{{ s.cipher }}</code></td>
        <td>{{ s.group or "not available" }}</td>{% endif %}
      </tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  <h2>Findings</h2>
  <div class="filters">
    <button class="on" data-label="all">All ({{ findings | length }})</button>
    <button data-label="red">Red ({{ summary.counts.red }})</button>
    <button data-label="yellow">Yellow ({{ summary.counts.yellow }})</button>
    <button data-label="green">Green ({{ summary.counts.green }})</button>
    <button data-label="info">Libraries ({{ summary.counts.info }})</button>
    <input id="q" type="search" placeholder="Filter by file, algorithm, code…" aria-label="Filter findings">
  </div>
  <div class="card table-wrap">
    <table id="findings">
      <thead><tr><th>Label</th><th>Algorithm</th><th>Where</th><th>Source</th><th>Evidence</th><th>Why</th></tr></thead>
      <tbody>
      {% for f in findings %}
      <tr data-label="{{ f.label }}">
        <td><span class="chip {{ f.label }}">{{ f.label }}</span></td>
        <td><b>{{ f.name }}</b><div class="muted small">{{ f.primitive }}{% if f.function %} · {{ f.function }}{% endif %}</div></td>
        <td><code>{{ f.file }}{% if f.line %}:{{ f.line }}{% endif %}</code></td>
        <td class="small">{{ f.source }}</td>
        <td><code>{{ f.evidence }}</code>{% if f.note %}<div class="muted small">{{ f.note }}</div>{% endif %}</td>
        <td class="small">{{ f.reason }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <h2>What this scan cannot see</h2>
  <div class="card small">
    Algorithm names built at runtime (for example <code>"sha" + "1"</code> or values read from
    configuration files), calls made through <code>getattr</code>, cryptography inside compiled
    libraries, languages other than Python, and transitive dependencies. Certificate trust is not
    checked. The TLS key-exchange group is the one negotiated with the scanning machine's OpenSSL.
  </div>
</main>
<script>
  const rows = [...document.querySelectorAll("#findings tbody tr")];
  const buttons = [...document.querySelectorAll(".filters button")];
  const q = document.getElementById("q");
  let label = "all";
  function apply() {
    const term = q.value.toLowerCase();
    rows.forEach(r => {
      const ok = (label === "all" || r.dataset.label === label) &&
                 (!term || r.textContent.toLowerCase().includes(term));
      r.style.display = ok ? "" : "none";
    });
  }
  buttons.forEach(b => b.addEventListener("click", () => {
    buttons.forEach(x => x.classList.remove("on"));
    b.classList.add("on"); label = b.dataset.label; apply();
  }));
  q.addEventListener("input", apply);
</script>
</body>
</html>
